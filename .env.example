# Copy this file to .env and fill in your values.
# NEVER commit your real .env file or share your API keys.

# Exchange (ccxt id, e.g. binance, bybit, kraken, coinbase, okx)
EXCHANGE_ID=kraken

# API credentials (leave empty for public market data / paper mode)
API_KEY=
API_SECRET=
API_PASSPHRASE=

# Paper is the only verified workflow. Do not set live until all release gates pass.
MODE=paper

# Symbol in CCXT format; quote currency must match your exchange/account.
SYMBOL=BTC/USD
TIMEFRAME=15m

# EMA(200) needs at least 200 completed candles; 300 allows indicator warmup.
CANDLE_LIMIT=300

# RSI recovery entry + EMA trend confirmation
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
EMA_PERIOD=200

# Position sizing only. These are NOT live protective stop/target orders.
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=10.0
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
MAX_OPEN_POSITIONS=1

POLL_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
