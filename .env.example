# Copy this file to .env and fill in your values.
# NEVER commit your real .env file or share your API keys.

# Exchange (ccxt id, e.g. binance, bybit, kraken, coinbase, okx)
EXCHANGE_ID=kraken

# API credentials (leave empty for pure paper / public data only)
API_KEY=
API_SECRET=
# Optional passphrase for some exchanges (e.g. OKX, KuCoin)
API_PASSPHRASE=

# Trading mode: "paper" (default, safe) or "live"
# LIVE TRADING USES REAL MONEY AND CAN LOSE EVERYTHING. TEST EXTENSIVELY FIRST.
MODE=paper

# Symbol to trade (ccxt format)
SYMBOL=BTC/USD

# Timeframe for candles
TIMEFRAME=15m

# How many candles to fetch for indicators
CANDLE_LIMIT=100

# RSI settings
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Risk management
RISK_PER_TRADE_PCT=1.0          # % of equity to risk per trade
MAX_POSITION_PCT=10.0           # max % of equity in one position
STOP_LOSS_PCT=2.0               # stop loss distance in %
TAKE_PROFIT_PCT=4.0             # take profit distance in %
MAX_OPEN_POSITIONS=1

# Loop settings
POLL_INTERVAL_SECONDS=60        # how often to check for signals
LOG_LEVEL=INFO
