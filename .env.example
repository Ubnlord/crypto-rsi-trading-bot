# Copy to .env locally. NEVER commit .env or share API keys.
# MODE=demo uses Bybit's demo endpoint for data; all bot fills remain local paper fills.
MODE=demo
EXCHANGE_ID=bybit
API_KEY=
API_SECRET=
API_PASSPHRASE=

# Symbol in CCXT format
SYMBOL=BTC/USDT
TIMEFRAME=15m
CANDLE_LIMIT=300

RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
EMA_PERIOD=200

# Hard-capped at 0.25% of equity by config and risk_controls.
RISK_PER_TRADE_PCT=0.25
MAX_POSITION_PCT=10.0
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
MAX_OPEN_POSITIONS=1

# Local simulated portfolio only; never commit this file.
PAPER_STATE_PATH=data/paper-state.json
PAPER_FEE_PCT=0.1
PAPER_SLIPPAGE_PCT=0.05
POLL_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
